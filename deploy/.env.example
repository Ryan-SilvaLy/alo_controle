# ============================================================
# Arquivo de Variáveis de Ambiente - ALO Controle
# ============================================================
# Copiar para backend/.env e preencher com valores reais
# Nunca commitar este arquivo no Git
# ============================================================

# ============================================================
# SEGURANÇA
# ============================================================
# Gerar chave com:
# python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-seu-secret-key-aqui

# Modo debug (NUNCA True em produção)
DEBUG=False

# ============================================================
# BANCO DE DADOS
# ============================================================
# Formato: postgres://usuario:senha@host:porta/banco
# Para PostgreSQL local: postgres://user:pass@localhost:5432/alo_controle
# Para PostgreSQL remoto: postgres://user:pass@db.example.com:5432/alo_controle
DATABASE_URL=postgres://alo_controle:senha_segura@localhost:5432/alo_controle

# Exigir SSL na conexão com banco de dados
# True se banco está em servidor remoto, False se local
DATABASE_SSL_REQUIRE=False

# ============================================================
# CORS E FRONTEND
# ============================================================
# URL do frontend (onde está o Angular rodando)
FRONTEND_URL=https://seu-dominio.com

# Lista de URLs do frontend (alternativa)
FRONTEND_URLS=https://seu-dominio.com,https://www.seu-dominio.com

# Origens CORS permitidas (específicas)
CORS_ALLOWED_ORIGINS=https://seu-dominio.com,https://www.seu-dominio.com

# Permitir todas as origens (NÃO recomendado em produção)
# CORS_ALLOW_ALL_ORIGINS=False

# Permitir credenciais (cookies, autorização)
CORS_ALLOW_CREDENTIALS=True

# ============================================================
# HOSTS PERMITIDOS
# ============================================================
# Django valida se a requisição vem de host permitido
# Deixar * aceita qualquer host (usar com Nginx proxy)
# ALLOWED_HOSTS=seu-dominio.com,www.seu-dominio.com

# ============================================================
# OPCIONAL: INTEGRAÇÕES
# ============================================================
# Email (para notificações, recuperação de senha)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu-email@gmail.com
# EMAIL_HOST_PASSWORD=senha-de-app-específica

# ============================================================
# LOGS (OPCIONAL)
# ============================================================
# LOG_LEVEL=INFO

# ============================================================
# TIMEZONE
# ============================================================
# TIME_ZONE=America/Sao_Paulo

# ============================================================
# STORAGE (OPCIONAL - para S3 ou similar)
# ============================================================
# USE_S3=False
# AWS_ACCESS_KEY_ID=sua-chave-acesso
# AWS_SECRET_ACCESS_KEY=sua-chave-secreta
# AWS_STORAGE_BUCKET_NAME=seu-bucket
# AWS_S3_REGION_NAME=sa-east-1
